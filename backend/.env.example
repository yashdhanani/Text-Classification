# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=NeuralText
APP_VERSION=1.0.0

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://neuraltext:neuraltext_secret_password@localhost:5432/neuraltext_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Security ─────────────────────────────────────────────────────────────────
# CHANGE THIS in production! Generate with: openssl rand -hex 32
JWT_SECRET_KEY=neuraltext_super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
MODEL_DIR=./storage/models

# ── File Upload Limits ───────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_DATASET_EXTENSIONS=.csv,.json,.jsonl,.parquet,.xlsx,.xls,.txt

# ── ML Settings ──────────────────────────────────────────────────────────────
DEFAULT_MODEL_ARCHITECTURE=bilstm
MAX_TRAINING_EPOCHS=50
